# ==============================================================================
# CloudScale — Global Environment Configuration Example
# Copy this file to .env and configure values before starting services.
# NEVER commit the actual .env file containing real secrets to version control.
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_DB=cloudscale
POSTGRES_USER=cloudscale_admin
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5438

# --- Redis Store ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_secure_redis_password

# --- Spring Boot Control Plane ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://postgres:5432/cloudscale

# JWT Configuration (Access Token: 15 min = 900000 ms, Refresh Token: 30 days = 2592000000 ms)
JWT_SECRET=replace_with_a_minimum_256_bit_random_secret_key_base64_encoded
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# Bootstrap Initial Administrator (Created safely on first startup if no super admin exists)
BOOTSTRAP_ADMIN_EMAIL=admin@cloudscale.local
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_temporary_admin_password
BOOTSTRAP_ADMIN_NAME="System Administrator"

# --- Python AI/ML Service ---
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_INTERNAL_URL=http://ai-service:8000

# Gemini API Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Node Agent Simulator ---
NODE_AGENT_PORT=8090
CONTROL_PLANE_URL=http://control-plane:8080
AGENT_HEARTBEAT_INTERVAL_SECONDS=30
AGENT_METRICS_INTERVAL_SECONDS=30

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=replace_with_secure_grafana_password

# --- Angular Console Frontend ---
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8080/api/v1
